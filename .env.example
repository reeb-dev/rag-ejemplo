# Clave de la API de Anthropic (https://console.anthropic.com/).
# Sin clave, la app funciona en "modo solo recuperación": muestra los fragmentos
# encontrados pero no genera una respuesta redactada.
ANTHROPIC_API_KEY=

# Modelo de Claude usado para generar las respuestas.
CLAUDE_MODEL=claude-opus-5-5

# Puerto del backend.
PORT=3001
