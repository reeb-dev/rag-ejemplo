# Clave de la API de Anthropic (https://console.anthropic.com/).
# Sin clave, la app responde sin IA: muestra los fragmentos encontrados y arma
# la respuesta copiando las frases más relevantes.
ANTHROPIC_API_KEY=

# Modelo de Claude usado para generar las respuestas.
CLAUDE_MODEL=claude-opus-5-5

# Puerto del backend.
PORT=3001
